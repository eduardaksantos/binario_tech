[31m-## Output streams[m
[31m-[m
[31m-  By default `debug` will log to stderr, however this can be configured per-namespace by overriding the `log` method:[m
[31m-[m
[31m-Example [_stdout.js_](./examples/node/stdout.js):[m
[31m-[m
[31m-```js[m
[31m-var debug = require('debug');[m
[31m-var error = debug('app:error');[m
[31m-[m
[31m-// by default stderr is used[m
[31m-error('goes to stderr!');[m
[31m-[m
[31m-var log = debug('app:log');[m
[31m-// set this namespace to log via console.log[m
[31m-log.log = console.log.bind(console); // don't forget to bind to console![m
[31m-log('goes to stdout');[m
[31m-error('still goes to stderr!');[m
[31m-[m
[31m-// set all output to go via console.info[m
[31m-// overrides all per-namespace log settings[m
[31m-debug.log = console.info.bind(console);[m
[31m-error('now goes to stdout via console.info');[m
[31m-log('still goes to stdout, but via console.info now');[m
[31m-```[m
[31m-[m
[31m-## Extend[m
[31m-You can simply extend debugger [m
[31m-```js[m
[31m-const log = require('debug')('auth');[m
[31m-[m
[31m-//creates new debug instance with extended namespace[m
[31m-const logSign = log.extend('sign');[m
[31m-const logLogin = log.extend('login');[m
[31m-[m
[31m-log('hello'); // auth hello[m
[31m-logSign('hello'); //auth:sign hello[m
[31m-logLogin('hello'); //auth:login hello[m
[31m-```[m
[31m-[m
[31m-## Set dynamically[m
[31m-[m
[31m-You can also enable debug dynamically by calling the `enable()` method :[m
[31m-[m
[31m-```js[m
[31m-let debug = require('debug');[m
[31m-[m
[31m-console.log(1, debug.enabled('test'));[m
[31m-[m
[31m-debug.enable('test');[m
[31m-console.log(2, debug.enabled('test'));[m
[31m-[m
[31m-debug.disable();[m
[31m-console.log(3, debug.enabled('test'));[m
[31m-[m
[31m-```[m
[31m-[m
[31m-print :   [m
[31m-```[m
[31m-1 false[m
[31m-2 true[m
[31m-3 false[m
[31m-```[m
[31m-[m
[31m-Usage :  [m
[31m-`enable(namespaces)`  [m
[31m-`namespaces` can include modes separated by a colon and wildcards.[m
[31m-   [m
[31m-Note that calling `enable()` completely overrides previously set DEBUG variable : [m
[31m-[m
[31m-```[m
[31m-$ DEBUG=foo node -e 'var dbg = require("debug"); dbg.enable("bar"); console.log(dbg.enabled("foo"))'[m
[31m-=> false[m
[31m-```[m
[31m-[m
[31m-`disable()`[m
[31m-[m
[31m-Will disable all namespaces. The functions returns the namespaces currently[m
[31m-enabled (and skipped). This can be useful if you want to disable debugging[m
[31m-temporarily without knowing what was enabled to begin with.[m
[31m-[m
[31m-For example:[m
[31m-[m
[31m-```js[m
[31m-let debug = require('debug');[m
[31m-debug.enable('foo:*,-foo:bar');[m
[31m-let namespaces = debug.disable();[m
[31m-debug.enable(namespaces);[m
[31m-```[m
[31m-[m
[31m-Note: There is no guarantee that the string will be identical to the initial[m
[31m-enable string, but semantically they will be identical.[m
[31m-[m
[31m-## Checking whether a debug target is enabled[m
[31m-[m
[31m-After you've created a debug instance, you can determine whether or not it is[m
[31m-enabled by checking the `enabled` property:[m
[31m-[m
[31m-```javascript[m
[31m-const debug = require('debug')('http');[m
[31m-[m
[31m-if (debug.enabled) {[m
[31m-  // do stuff...[m
[31m-}[m
[31m-```[m
[31m-[m
[31m-You can also manually toggle this property to force the debug instance to be[m
[31m-enabled or disabled.[m
