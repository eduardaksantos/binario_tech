[31m-```[m
[31m-[m
[31m-## Usage[m
[31m-[m
[31m-```js[m
[31m-const normalize = require('normalize-path');[m
[31m-[m
[31m-console.log(normalize('\\foo\\bar\\baz\\')); [m
[31m-//=> '/foo/bar/baz'[m
[31m-```[m
[31m-[m
[31m-**win32 namespaces**[m
[31m-[m
[31m-```js[m
